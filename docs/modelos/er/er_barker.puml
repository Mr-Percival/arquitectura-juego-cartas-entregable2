@startdot er_barker
digraph ER {
  graph [rankdir=TB, splines=true, nodesep=0.45, ranksep=0.35, fontname="Arial", pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#F7F9FC", color="#2F4A6D", fontname="Arial", fontsize=11, margin="0.12,0.06"];
  edge [color="#2F4A6D", fontname="Arial", fontsize=9, fontcolor="#333333", arrowsize=0.9];
  JUGADOR [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>JUGADOR</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"># id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* alias</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o correo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* creado en</FONT></TD></TR></TABLE>>];
  SESION [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>SESIÓN</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"># id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* token hash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* estado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* iniciada en</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* última actividad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* expira en</FONT></TD></TR></TABLE>>];
  SALA [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>SALA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"># id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* código invitación</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* capacidad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* estado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* creada en</FONT></TD></TR></TABLE>>];
  VARIANTE [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>VARIANTE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"># código</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* versión plug-in</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* versión contrato</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* activa</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* registrada en</FONT></TD></TR></TABLE>>];
  PARTIDA [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>PARTIDA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"># id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* estado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o iniciada en</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o finalizada en</FONT></TD></TR></TABLE>>];
  PARAMETRO_PARTIDA [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>PARÁMETRO PARTIDA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"># clave</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* valor</FONT></TD></TR></TABLE>>];
  PARTICIPACION [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>PARTICIPACIÓN</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* asiento</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* estado jugador</FONT></TD></TR></TABLE>>];
  PUNTAJE_ACUMULADO [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>PUNTAJE ACUMULADO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* total</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* versión</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* actualizado en</FONT></TD></TR></TABLE>>];
  RONDA [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>RONDA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"># id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* número</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* estado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* semilla</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* iniciada en</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o cerrada en</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o tipo cierre</FONT></TD></TR></TABLE>>];
  CARTA [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>CARTA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"># código</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o rango</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o pinta</FONT></TD></TR></TABLE>>];
  MANO_JUGADOR [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>MANO JUGADOR</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"># id</FONT></TD></TR></TABLE>>];
  CARTA_MANO [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>CARTA MANO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"># mazo número</FONT></TD></TR></TABLE>>];
  TURNO_JUGADA [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>TURNO JUGADA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"># id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* número turno</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* acción</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o mazo número</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* resultado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">o motivo rechazo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* comando id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* ocurrida en</FONT></TD></TR></TABLE>>];
  PUNTAJE_RONDA [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>PUNTAJE RONDA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* penalización</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">* bonificación</FONT></TD></TR></TABLE>>];
  r0 [shape=point, width=0.01, height=0.01, label=""];
  JUGADOR -> r0 [dir=none, style=dashed, label=" abrir"];
  r0 -> SESION [arrowhead=crow, style=solid, label=" pertenecer a"];
  r1 [shape=point, width=0.01, height=0.01, label=""];
  JUGADOR -> r1 [dir=none, style=dashed, label=" ser anfitrión de"];
  r1 -> SALA [arrowhead=crow, style=solid, label=" ser creada por"];
  r2 [shape=point, width=0.01, height=0.01, label=""];
  SALA -> r2 [dir=none, style=dashed, label=" alojar"];
  r2 -> PARTIDA [arrowhead=crow, style=solid, label=" jugarse en"];
  r3 [shape=point, width=0.01, height=0.01, label=""];
  VARIANTE -> r3 [dir=none, style=dashed, label=" regir"];
  r3 -> PARTIDA [arrowhead=crow, style=solid, label=" regirse por"];
  r4 [shape=point, width=0.01, height=0.01, label=""];
  JUGADOR -> r4 [dir=none, style=dashed, label=" ganar"];
  r4 -> PARTIDA [arrowhead=crow, style=dashed, label=" ser ganada por"];
  r5 [shape=point, width=0.01, height=0.01, label=""];
  PARTIDA -> r5 [dir=none, style=dashed, label=" configurarse con"];
  r5 -> PARAMETRO_PARTIDA [arrowhead=crowtee, style=solid, label=" configurar"];
  r6 [shape=point, width=0.01, height=0.01, label=""];
  PARTIDA -> r6 [dir=none, style=solid, label=" tener"];
  r6 -> PARTICIPACION [arrowhead=crowtee, style=solid, label=" ser de"];
  r7 [shape=point, width=0.01, height=0.01, label=""];
  JUGADOR -> r7 [dir=none, style=dashed, label=" participar en"];
  r7 -> PARTICIPACION [arrowhead=crowtee, style=solid, label=" ser de"];
  r8 [shape=point, width=0.01, height=0.01, label=""];
  PARTICIPACION -> r8 [dir=none, style=dashed, label=" llevar"];
  r8 -> PUNTAJE_ACUMULADO [arrowhead=tee, style=solid, label=" ser de"];
  r9 [shape=point, width=0.01, height=0.01, label=""];
  PARTIDA -> r9 [dir=none, style=dashed, label=" dividirse en"];
  r9 -> RONDA [arrowhead=crow, style=solid, label=" pertenecer a"];
  r10 [shape=point, width=0.01, height=0.01, label=""];
  PARTICIPACION -> r10 [dir=none, style=dashed, label=" cerrar"];
  r10 -> RONDA [arrowhead=crow, style=dashed, label=" ser cerrada por"];
  r11 [shape=point, width=0.01, height=0.01, label=""];
  RONDA -> r11 [dir=none, style=dashed, label=" repartir"];
  r11 -> MANO_JUGADOR [arrowhead=crow, style=solid, label=" darse en"];
  r12 [shape=point, width=0.01, height=0.01, label=""];
  JUGADOR -> r12 [dir=none, style=dashed, label=" sostener"];
  r12 -> MANO_JUGADOR [arrowhead=crow, style=solid, label=" ser de"];
  r13 [shape=point, width=0.01, height=0.01, label=""];
  MANO_JUGADOR -> r13 [dir=none, style=dashed, label=" contener"];
  r13 -> CARTA_MANO [arrowhead=crowtee, style=solid, label=" estar en"];
  r14 [shape=point, width=0.01, height=0.01, label=""];
  CARTA -> r14 [dir=none, style=dashed, label=" ubicarse como"];
  r14 -> CARTA_MANO [arrowhead=crowtee, style=solid, label=" ser"];
  r15 [shape=point, width=0.01, height=0.01, label=""];
  MANO_JUGADOR -> r15 [dir=none, style=dashed, label=" registrar"];
  r15 -> TURNO_JUGADA [arrowhead=crow, style=solid, label=" hacerse con"];
  r16 [shape=point, width=0.01, height=0.01, label=""];
  CARTA -> r16 [dir=none, style=dashed, label=" moverse en"];
  r16 -> TURNO_JUGADA [arrowhead=crow, style=dashed, label=" mover"];
  r17 [shape=point, width=0.01, height=0.01, label=""];
  RONDA -> r17 [dir=none, style=dashed, label=" liquidarse en"];
  r17 -> PUNTAJE_RONDA [arrowhead=crowtee, style=solid, label=" liquidar"];
  r18 [shape=point, width=0.01, height=0.01, label=""];
  JUGADOR -> r18 [dir=none, style=dashed, label=" recibir"];
  r18 -> PUNTAJE_RONDA [arrowhead=crowtee, style=solid, label=" asignarse a"];
}
@enddot
